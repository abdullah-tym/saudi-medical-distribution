from odoo import models, fields, api

class StockPicking(models.Model):
    _inherit = 'stock.picking'

    cold_chain_compliant = fields.Boolean(string='Cold Chain Verified', tracking=True)
    transit_temperature_recorded = fields.Float(string='Recorded Transit Temp (°C)', tracking=True)
    temperature_deviation_notes = fields.Text(string='Temperature Deviation Remarks')

    @api.onchange('transit_temperature_recorded')
    def _onchange_transit_temperature(self):
        for picking in self:
            # Auto-check if any move line involves cold chain products violating thresholds
            cold_products = picking.move_line_ids.mapped('product_id').filtered(lambda p: p.is_cold_chain)
            if cold_products and picking.transit_temperature_recorded:
                min_t = min(cold_products.mapped('min_temperature'))
                max_t = max(cold_products.mapped('max_temperature'))
                if not (min_t <= picking.transit_temperature_recorded <= max_t):
                    picking.cold_chain_compliant = False
                else:
                    picking.cold_chain_compliant = True
