<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_sfda" model="ir.ui.view">
        <field name="name">stock.production.lot.form.inherit.sfda</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="sfda_release_status" widget="badge" decoration-success="sfda_release_status == 'approved'" decoration-warning="sfda_release_status == 'pending'" decoration-danger="sfda_release_status == 'rejected'"/>
                <field name="regulatory_certificate_no"/>
            </xpath>
        </field>
    </record>
</odoo>
